{
    "name": "smile/module-retailer-admin",
    "type": "magento2-module",
    "description": "Smile Retailer Admin",
    "keywords": ["magento2", "retailer admin acl", "retailer admin", "retailer filter", "retailer offer filter"],
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": ">=103.0.4 <103.0.6",
        "magento/module-store": "*",
        "magento/module-checkout": "*",
        "smile/module-retailer-offer": "^2.0",
        "smile/module-retailer": "^2.0"
    },
    "require-dev": {
        "smile/magento2-smilelab-quality-suite": "^4.0"
    },
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "Florent Maissiat",
            "email": "florent.maissiat@smile.eu"
        },
        {
            "name": "Tony DEPLANQUE",
            "email": "tony.deplanque@smile.fr"
        },
        {
            "name": "Fanny DECLERCK",
            "email": "fadec@smile.fr"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Smile\\RetailerAdmin\\" : ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/magento-composer-installer": false
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    }
}
